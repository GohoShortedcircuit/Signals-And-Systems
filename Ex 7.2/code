// Test Case: Fourier Series of Half-Wave Rectifier Output
// Define parameters
A = 1; // Amplitude of the input sinusoidal signal
f = 1; // Frequency of the sinusoidal signal (Hz)
T = 1/f; // Period of the sinusoidal signal
t = 0:0.001:2*T; // Fine time vector for smooth integration and plotting

// Define the input sinusoidal signal 
x_t = A * sin(2 * %pi * f * t);

// Define the half-wave rectified output signal
y_t = max(x_t, 0); // Rectified output

// Number of harmonics to compute for Fourier series
N_harmonics = 10; 

// Compute Fourier series analytical/exact coefficients for half-wave rectifier
// DC component: a0/2 = A/%pi
a0 = 2 * A / %pi;

an = zeros(1, N_harmonics);
bn = zeros(1, N_harmonics);

// Fundamental sine component
bn(1) = A / 2;

// Even harmonics cosine components
for n = 2:2:N_harmonics
    an(n) = (2 * A / %pi) * (1 / (1 - n^2));
end

// Reconstruct the signal using Fourier series
y_reconstructed = (a0 / 2) * ones(1, length(t)); // Start with DC component
for n = 1:N_harmonics
    y_reconstructed = y_reconstructed + an(n) * cos(2 * %pi * n * f * t) + bn(n) * sin(2 * %pi * n * f * t);
end

// Clear current figure
clf; 

// Plot the original half-wave rectified signal 
subplot(3,1,1);
plot(t, y_t, 'r'); 
xlabel('t (Time)'); 
ylabel('Amplitude');
title('Half-Wave Rectified Output Signal');

// Plot the reconstructed signal using Fourier series 
subplot(3,1,2);
plot(t, y_reconstructed, 'b'); 
xlabel('t (Time)'); 
ylabel('Amplitude');
title('Reconstructed Signal using Fourier Series with ' + string(N_harmonics) + ' Harmonics');

// Plot the original vs reconstructed signal for comparison 
subplot(3,1,3);
plot(t, y_t, 'r');
plot(t, y_reconstructed, 'b--');
xlabel('t (Time)'); 
ylabel('Amplitude');
title('Comparison of Original and Reconstructed Signal'); 
hl = legend(['Original Signal', 'Reconstructed Signal']);
